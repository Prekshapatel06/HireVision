# ==========================================
# HIREVISION BACKEND ENVIRONMENT
# ==========================================

PORT=5000

# ==========================================
# FRONTEND
# ==========================================

FRONTEND_URL=http://localhost:3000

# ==========================================
# JWT
# ==========================================

JWT_SECRET=replace_with_a_long_secure_random_secret
JWT_EXPIRES_IN=7d

# ==========================================
# POSTGRESQL
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hirevision
DB_USER=postgres
DB_PASSWORD=postgres

DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# ==========================================
# OPENAI
# ==========================================

OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2

# ==========================================
# GITHUB
# ==========================================

# Optional but recommended.
# GitHub API gives a higher rate limit when a token is provided.
GITHUB_TOKEN=

GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_RETRIES=2

GITHUB_USER_AGENT=HireVision-AI

# ==========================================
# LINKEDIN OAUTH
# ==========================================

# Create a LinkedIn application and add
# its Client ID and Client Secret here.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# IMPORTANT:
# This exact callback URL must also be configured
# in the LinkedIn Developer Portal.
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/ai/linkedin/callback

# ==========================================
# LINKEDIN SECURITY
# ==========================================

# Use a strong random secret.
#
# This signs the OAuth state so another user
# cannot modify userId/profile details inside
# the authorization callback.
LINKEDIN_OAUTH_STATE_SECRET=

# Use a separate strong random key.
#
# HireVision encrypts LinkedIn access tokens
# before saving them to PostgreSQL.
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# ==========================================
# LINKEDIN SCOPES
# ==========================================

# Standard LinkedIn OpenID Connect scopes.
#
# These normally provide basic authenticated
# member identity/profile data.
LINKEDIN_SCOPES=openid profile email

# ==========================================
# LINKEDIN REQUEST CONFIG
# ==========================================

LINKEDIN_TIMEOUT_MS=15000

# OAuth state expiry.
# 600 seconds = 10 minutes.
LINKEDIN_STATE_MAX_AGE_SECONDS=600

# ==========================================
# LINKEDIN EXTENDED PROFILE API
# ==========================================

# Keep FALSE unless the LinkedIn application
# has actually been approved for the required
# richer LinkedIn APIs.
#
# HireVision will NOT scrape or fabricate
# LinkedIn profile data.
LINKEDIN_ENABLE_PROFILE_API=false

# Only configure this when LinkedIn has approved
# an API endpoint for your application.
#
# Security check inside HireVision only allows
# https://api.linkedin.com URLs here.
LINKEDIN_PROFILE_API_URL=

# LinkedIn API version if required by the
# approved endpoint.
LINKEDIN_API_VERSION=

# If false:
# HireVision continues using standard OIDC data
# even if the optional extended API is unavailable.
#
# If true:
# LinkedIn scan fails when the extended API fails.
LINKEDIN_PROFILE_API_REQUIRED=false

# ==========================================
# LINKEDIN FRONTEND RETURN URL
# ==========================================

# LinkedIn authorization ke baad candidate ko
# is page par return kiya jayega.
#
# Frontend yahan query params read karega:
#
# ?linkedin=connected
#
# or
#
# ?linkedin=error&linkedin_error=...
LINKEDIN_FRONTEND_RETURN_URL=http://localhost:3000/dashboard

# ==========================================
# GOOGLE AUTH
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ==========================================
# MICROSOFT AUTH
# ==========================================

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback

# ==========================================
# NODE ENVIRONMENT
# ==========================================

NODE_ENV=development